SESSIONGRID_APP_NAME=SessionGrid
SESSIONGRID_ENV=development
SESSIONGRID_DATABASE_URL=sqlite:///./sessiongrid.db
SESSIONGRID_RUNTIME_DIR=./runtime_data
SESSIONGRID_HEADLESS=true
SESSIONGRID_SCREENSHOT_QUALITY=65
SESSIONGRID_DEFAULT_START_URL=https://example.com

# Local development uses the seeded admin principal. In a shared/staging
# environment set AUTH_REQUIRED=true and supply a high-entropy bootstrap key.
SESSIONGRID_AUTH_REQUIRED=false
SESSIONGRID_AUTO_CREATE_SCHEMA=true
SESSIONGRID_BOOTSTRAP_ADMIN_EMAIL=admin@sessiongrid.local
SESSIONGRID_BOOTSTRAP_ADMIN_NAME=Local Admin
SESSIONGRID_BOOTSTRAP_API_KEY=
SESSIONGRID_DEFAULT_ORGANIZATION_NAME=SessionGrid Demo
SESSIONGRID_DEFAULT_ORGANIZATION_SLUG=sessiongrid-demo
SESSIONGRID_DEFAULT_WORKSPACE_NAME=Default Workspace
